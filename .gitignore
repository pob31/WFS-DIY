# Profiler results
Builds/**/Intel*VTune*Profiler*Results/

# Build outputs and artifacts
Builds/*/x64/
Builds/*/x86/
Builds/*/Debug/
Builds/*/Release/
Builds/*/RelWithDebInfo/
Builds/*/MinSizeRel/
Builds/*/build/
Builds/*/release/

# Plugin installer outputs (.pkg, .exe, .tar.gz)
Plugin/Installer/Output/
Plugin/Builds/

# Release staging — scripts/ci/build-macos-release.sh and release.yml assemble the
# DMG / Setup.exe / tar.gz (+ .sha256) here before uploading them as GitHub Release
# assets, and docs/Linux_AMD_Release_Tarball.md writes the ROCm tarball here too.
# All generated, all published elsewhere, and large enough (~80 MB per ROCm tarball)
# that one accidental commit would bloat the history permanently. None of the
# *.exe/*.so/*.dll rules above catch a .tar.gz or a .sha256.
dist/

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.app

# Exception: the prebuilt AMD/HIP GPU plugin is committed on purpose because the
# Windows CI runner has no AMD HIP SDK to build it (see
# tools/windows/prebuilt/README.md). Force-tracked despite the *.dll rule above.
!tools/windows/prebuilt/wfs_hip.dll
# ...but not the import lib / export file the DLL build drops next to it —
# nothing links against the plugin (it's LoadLibrary'd at runtime).
tools/windows/prebuilt/*.lib
tools/windows/prebuilt/*.exp

# Object files
*.obj
*.o
*.lo
*.slo

# Debug symbols
*.pdb
*.ilk
*.map

# Build logs and temporary files
*.log
*.tlog
*.recipe
*.lastbuildstate
*.FileListAbsolute.txt
*.Build.CppClean.log

# Visual Studio temporary files
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache and temporary directories
.vs/
.vscode/

# Visual Studio build outputs (already covered by general patterns above)
Builds/*/x64/
Builds/*/x86/
Builds/*/Debug/
Builds/*/Release/

# Xcode temporary files
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
project.xcworkspace/
xcuserdata/

# CMake build files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# IDE files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# JUCE specific — JuceLibraryCode/ is tracked so users can build without Projucer

# Build configuration files (generated by JUCE/Projucer)
# These ARE tracked so users can clone and build without Projucer.
# After saving in Projucer, review changes with `git diff` before committing.

# Processor build artifacts
Processors/*/build/
Processors/*/out/
# Claude Code temporary files
tmpclaude-*
**/tmpclaude-*

# Python cache and test artefacts (Phase 0 generator script)
__pycache__/
.pytest_cache/
Experiments/metal-wfs-spike/spike
Experiments/metal-wfs-spike/backend_test

# GPU plugin smoke-test harness — compiled ad hoc by the g++ line in
# Documentation/GPU_Plugin_Smoke_Test.md, and extensionless on POSIX so none of
# the *.exe/*.so rules above catch it. The .cpp source stays tracked.
tools/test-gpu-plugin

# Head-tracker plugin (tools/headtrack): local CMake build trees (build/ =
# system OpenCV, build-bundled/ = the static-OpenCV release build, which
# contains a full OpenCV compilation) and the cached OpenCV prebuilt the
# Windows build script downloads. The vendored YuNet model IS tracked
# (models/*.onnx) — it ships with the app.
tools/headtrack/build/
tools/headtrack/build-bundled/
tools/headtrack/.opencv/
build-spatcore-tests/
tools/validation/control-replay/wfs-control-replay/
